# OpenRouter API Configuration (get free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Crawler Settings
MAX_CRAWL_DEPTH=2
MAX_PAGES_PER_SITE=50
CRAWL_DELAY_SECONDS=1.0

# RAG Settings
CHUNK_SIZE=400
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# Embedding Model (OpenRouter)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Chat Model (OpenRouter - use free models like meta-llama/llama-3.1-8b-instruct:free or google/gemini-flash-1.5-8b:free)
CHAT_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Storage
VECTOR_STORE_PATH=./storage/vector_stores
SESSION_STORE_PATH=./storage/sessions
